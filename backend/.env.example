SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side AI provider credentials
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Persistent clinical memory; delegate must be registered to this account on this network
WALRUS_ENABLED=true
WALRUS_ENV=dev
WALRUS_DELEGATE_KEY=your-registered-walrus-delegate-private-key
WALRUS_ACCOUNT_ID=0x-your-walrus-account-object-id
WALRUS_SERVER_URL=https://relayer.dev.memwal.ai

# Telegram bot webhook; set the same secret in the Telegram webhook and backend host
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Public bot username used by the Login Widget; set this bot's domain via @BotFather /setdomain.
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign
TELEGRAM_SECRET_TOKEN=generate-a-random-secret-token
TELEGRAM_WEBHOOK_URL=https://your-render-service.onrender.com/telegram/webhook

# App-issued JWT signing secret; generate a unique value for deployment
SECRET_KEY=generate-a-random-secret-at-least-32-characters
ENVIRONMENT=production